                                  {
                                      "name":  "POST Tambah Prodi",
                                      "event":  [
                                                    {
                                                        "listen":  "test",
                                                        "script":  {
                                                                       "type":  "text/javascript",
                                                                       "exec":  [
                                                                                    "pm.test(\u0027Status code 201\u0027, () =\u003e pm.response.to.have.status(201));",
                                                                                    "const body = pm.response.json();",
                                                                                    "pm.test(\u0027Response memiliki _id dan nama yang sesuai\u0027, () =\u003e {",
                                                                                    "  pm.expect(body).to.have.property(\u0027_id\u0027);",
                                                                                    "  pm.expect(body.nama).to.eql(\u0027Sistem Informasi\u0027);",
                                                                                    "});",
                                                                                    "pm.test(\u0027Jenjang default adalah S1\u0027, () =\u003e pm.expect(body.jenjang).to.eql(\u0027S1\u0027));",
                                                                                    "pm.environment.set(\u0027prodiId\u0027, body._id);"
                                                                                ]
                                                                   }
                                                    }
                                                ],
                                      "request":  {
                                                      "method":  "POST",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Content-Type",
                                                                         "value":  "application/json"
                                                                     }
                                                                 ],
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                   "raw":  "{\n  \"nama\": \"Sistem Informasi\"\n}"
                                                               },
                                                      "url":  {
                                                                  "raw":  "{{base_url}}/prodi",
                                                                  "host":  [
                                                                               "{{base_url}}"
                                                                           ],
                                                                  "path":  [
                                                                               "prodi"
                                                                           ]
                                                              }
                                                  }
