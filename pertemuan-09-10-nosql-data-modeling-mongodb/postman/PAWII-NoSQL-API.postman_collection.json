                                                                       "exec":  [
                                                                                    "pm.test(\u0027Status code 200\u0027, () =\u003e pm.response.to.have.status(200));",
                                                                                    "const body = pm.response.json();",
                                                                                    "pm.test(\u0027Response berupa array\u0027, () =\u003e pm.expect(body).to.be.an(\u0027array\u0027));",
                                                                                    "pm.test(\u0027Berisi prodi yang baru dibuat\u0027, () =\u003e {",
                                                                                    "  pm.expect(body.map(p =\u003e p._id)).to.include(pm.environment.get(\u0027prodiId\u0027));",
