                 {
                     "name":  "Mahasiswa",
                     "item":  [
                                  {
                                      "name":  "POST Tambah Mahasiswa",
                                      "event":  [
                                                    {
                                                        "listen":  "prerequest",
                                                        "script":  {
                                                                       "type":  "text/javascript",
                                                                       "exec":  [
                                                                                    "// NIM harus unik, jadi dibuat baru setiap kali request dijalankan",
                                                                                    "pm.environment.set(\u0027nim\u0027, \u0027T\u0027 + Date.now());",
                                                                                    "",
                                                                                    "// Jika prodiId belum ada (request dijalankan sendiri), buat prodi terlebih dahulu",
                                                                                    "if (!pm.environment.get(\u0027prodiId\u0027)) {",
                                                                                    "  pm.sendRequest({",
                                                                                    "    url: pm.environment.get(\u0027base_url\u0027) + \u0027/prodi\u0027,",
                                                                                    "    method: \u0027POST\u0027,",
                                                                                    "    header: { \u0027Content-Type\u0027: \u0027application/json\u0027 },",
                                                                                    "    body: { mode: \u0027raw\u0027, raw: JSON.stringify({ nama: \u0027Sistem Informasi\u0027 }) }",
                                                                                    "  }, (err, res) =\u003e {",
                                                                                    "    if (err) { console.error(\u0027Gagal membuat prodi:\u0027, err); return; }",
                                                                                    "    pm.environment.set(\u0027prodiId\u0027, res.json()._id);",
                                                                                    "  });",
                                                                                    "}"
                                                                                ]
                                                                   }
                                                    },
                                                    {
                                                        "listen":  "test",
                                                        "script":  {
                                                                       "type":  "text/javascript",
                                                                       "exec":  [
                                                                                    "pm.test(\u0027Status code 201\u0027, () =\u003e pm.response.to.have.status(201));",
                                                                                    "const body = pm.response.json();",
                                                                                    "pm.test(\u0027Response memiliki _id\u0027, () =\u003e pm.expect(body).to.have.property(\u0027_id\u0027));",
                                                                                    "pm.test(\u0027Data tersimpan dengan benar\u0027, () =\u003e {",
                                                                                    "  pm.expect(body.nama).to.eql(\u0027Citra\u0027);",
                                                                                    "  pm.expect(body.nim).to.eql(pm.environment.get(\u0027nim\u0027));",
                                                                                    "  pm.expect(body.alamat.kota).to.eql(\u0027Bandung\u0027);",
                                                                                    "  pm.expect(body.prodiId).to.eql(pm.environment.get(\u0027prodiId\u0027));",
                                                                                    "});",
                                                                                    "pm.environment.set(\u0027mahasiswaId\u0027, body._id);"
                                                                                ]
                                                                   }
                                                    }
                                                ],
                                      "request":  {
                                                      "method":  "POST",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Content-Type",
                                                                         "value":  "application/json"
                                                                     }
                                                                 ],
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                   "raw":  "{\n  \"nama\": \"Citra\",\n  \"nim\": \"{{nim}}\",\n  \"alamat\": { \"jalan\": \"Jl. Merdeka 1\", \"kota\": \"Bandung\" },\n  \"prodiId\": \"{{prodiId}}\"\n}"
                                                               },
                                                      "url":  {
                                                                  "raw":  "{{base_url}}/mahasiswa",
                                                                  "host":  [
                                                                               "{{base_url}}"
                                                                           ],
                                                                  "path":  [
                                                                               "mahasiswa"
