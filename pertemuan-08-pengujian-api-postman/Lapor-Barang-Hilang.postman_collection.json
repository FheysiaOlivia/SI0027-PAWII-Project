{
  "info": {
    "name": "Lapor Barang Hilang dan Ditemukan",
    "description": "Automated API testing untuk project akhir Sistem Informasi Barang Hilang dan Ditemukan Kampus MDP",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET - Semua Laporan",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Status success', function () { pm.expect(pm.response.json().status).to.eql('success'); });",
              "pm.test('Data berupa array', function () { pm.expect(pm.response.json().data).to.be.an('array'); });",
              "pm.test('Struktur laporan sesuai', function () {",
              "  pm.response.json().data.forEach(function (item) {",
              "    ['id', 'jenis', 'nama_barang', 'deskripsi', 'lokasi', 'tanggal', 'status'].forEach(function (key) {",
              "      pm.expect(item).to.have.property(key);",
              "    });",
              "  });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "http://localhost:3000/api/laporan"
      }
    },
    {
      "name": "GET - Detail Laporan",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code 200', function () { pm.response.to.have.status(200); });",
              "pm.test('ID laporan sesuai', function () { pm.expect(pm.response.json().data.id).to.eql('1'); });",
              "pm.test('Nama barang sesuai', function () { pm.expect(pm.response.json().data.nama_barang).to.eql('Dompet Hitam'); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "http://localhost:3000/api/laporan/1"
      }
    },
    {
      "name": "POST - Tambah Laporan",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code 201', function () { pm.response.to.have.status(201); });",
              "pm.test('Status success', function () { pm.expect(pm.response.json().status).to.eql('success'); });",
              "pm.test('Data laporan berhasil dibuat', function () {",
              "  var data = pm.response.json().data;",
              "  pm.expect(data.id).to.exist;",
              "  pm.expect(data.nama_barang).to.eql('Payung Biru');",
              "  pm.environment.set('laporanId', data.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"jenis\": \"Hilang\",\n  \"nama_barang\": \"Payung Biru\",\n  \"deskripsi\": \"Payung tertinggal\",\n  \"lokasi\": \"Gedung B\",\n  \"tanggal\": \"2026-10-22\",\n  \"status\": \"menunggu\"\n}"
        },
        "url": "http://localhost:3000/api/laporan"
      }
    },
    {
      "name": "PUT - Update Laporan",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Nama barang berhasil diperbarui', function () { pm.expect(pm.response.json().data.nama_barang).to.eql('Payung Biru Updated'); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nama_barang\": \"Payung Biru Updated\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/laporan/{{laporanId}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "laporan", "{{laporanId}}"]
        }
      }
    },
    {
      "name": "DELETE - Hapus Laporan",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Data laporan yang dihapus sesuai', function () { pm.expect(pm.response.json().data.nama_barang).to.eql('Payung Biru Updated'); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "http://localhost:3000/api/laporan/{{laporanId}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "laporan", "{{laporanId}}"]
        }
      }
    }
  ]
}
